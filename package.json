{
  "name": "v-core-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:cloudflare": "next build",
    "start": "serve out -l 3010",
    "preview": "serve out -l 3010",
    "deploy:cloudflare": "wrangler pages deploy out --project-name v-core-saas",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "proof:performance": "tsx scripts/prove-performance.ts",
    "proof:lighthouse": "tsx scripts/run-lighthouse.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run proof:performance && npm run e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "lighthouse": "^13.5.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  }
}
