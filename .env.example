# Cloudflare Pages deployment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=v-core-saas
BACKEND_ORIGIN=https://your-backend.example.com
# Set both values to the same generated secret in their respective runtimes.
BFF_SHARED_SECRET=
VCORE_BFF_SHARED_SECRET=
DEMO_USER_EMAIL=owner@v-core.local

# Optional Cloudflare R2/S3-compatible credentials. V-Core does not use R2 yet.
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API_ENDPOINT=

# Neon provisioning. The API key is not used by the Spring Boot runtime.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# PostgreSQL runtime. Prefer the pooled Neon endpoint in hosted environments.
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://host/database?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Upstash Redis runtime. Spring Boot needs the TLS Redis URL, not only REST credentials.
SPRING_DATA_REDIS_URL=rediss://default:password@host:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Grafana Cloud / OpenTelemetry (optional until observability is enabled).
GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_ACCESS_TOKEN=
OTEL_SERVICE_NAME=v-core-api
OTEL_EXPORTER_ENABLED=false
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
GRAFANA_OTLP_AUTHORIZATION=
DEPLOYMENT_ENVIRONMENT=production

# Future Google Cloud Run deployment. These are identifiers, not secrets.
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
GCP_ARTIFACT_REGISTRY_REPOSITORY=v-core
GCP_CLOUD_RUN_SERVICE=v-core-api
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_DEPLOY_SERVICE_ACCOUNT=

# Do not store a personal GitHub token here. GitHub Actions provides GITHUB_TOKEN.
